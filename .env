# WoW Bot Configuration

# Hotkey to start/stop fishing (keyboard library format)
WOWBOT_HOTKEY=ctrl+shift+f

# Key to cast fishing (1-9, a-z, space, enter, etc.)
WOWBOT_FISH_KEY=1

# Monitor index for mss screen capture (0 = all monitors combined, 1 = primary)
WOWBOT_MONITOR=1

# Bobber template match threshold (0.0-1.0, lower = easier to find)
# Your bobber peaks at ~0.37, UI elements at ~0.35-0.36.
# 0.40 filters most false positives while catching the real bobber.
WOWBOT_BOBBER_THRESHOLD=0.37

# Visual debug overlay — shows a window with the bobber highlighted in red
# 1 = enabled, 0 = disabled
WOWBOT_VISUAL_DEBUG=1

# Audio debug - set to 1 to print the measured level and the reason each block
# was rejected (noisy; use `python main.py --audio-debug` to tune instead)
WOWBOT_AUDIO_DEBUG=0

# ── Audio capture device ───────────────────────────────────────────────
# The bot cannot use WASAPI loopback: it captures a recording device that
# hears the game (Stereo Mix / "Mixage stéréo" / VB-Audio "CABLE Output").
# Auto-detection tries Stereo Mix-style devices first, then other inputs, and
# only falls back to the default microphone last.
# If it picks the wrong device, force it by index (see --list-audio) or by
# part of its name (case-insensitive):
# WOWBOT_AUDIO_DEVICE=23
# WOWBOT_AUDIO_DEVICE=cable

# Audio detection tuning.
# WOWBOT_MIN_AMP is only a "not digital silence" guard: it must sit well BELOW
# the level a splash reaches on your setup. Measured here (Stereo Mix):
#   idle silence ~0.00002, normal gameplay ambience ~0.0008, splash ~0.0031.
# Run `python main.py --audio-debug`, watch `rms`, then set this to roughly a
# quarter of the loudest splash you see.
WOWBOT_MIN_AMP=0.0015
# Spike must be this many times louder than the median of the last 1.5 s.
# Lower = more sensitive (2.0 is a good default; 1.5 catches very soft bites).
WOWBOT_SPIKE_MULT=2.0

# Scan region (optional — uncomment and set values to limit scan area)
SCAN_LEFT=1001
SCAN_TOP=361
SCAN_WIDTH=637
SCAN_HEIGHT=343

# Optional: nudge the catch click if it lands next to the bobber (pixels).
# For the current bobber.png the sprite sits ~6px right / ~7px below the crop
# centre; uncomment both lines if catches keep failing while the bobber is
# clearly visible on screen.
# WOWBOT_CLICK_OFFSET_X=6
# WOWBOT_CLICK_OFFSET_Y=7