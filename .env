# WoW Bot Configuration

# Hotkey to start/stop fishing (keyboard library format)
WOWBOT_HOTKEY=ctrl+shift+f

# Key to cast fishing (1-9, a-z, space, enter, etc.)
WOWBOT_FISH_KEY=1

# Monitor index for mss screen capture (0 = all monitors combined, 1 = primary)
WOWBOT_MONITOR=1

# Bobber template match threshold (0.0-1.0, lower = easier to find)
# Your bobber peaks at ~0.37, UI elements at ~0.35-0.36.
# 0.40 filters most false positives while catching the real bobber.
WOWBOT_BOBBER_THRESHOLD=0.50

# Visual debug overlay — shows a window with the bobber highlighted in red
# 1 = enabled, 0 = disabled
WOWBOT_VISUAL_DEBUG=1

# Audio debug — prints RMS amplitude every ~0.5s to help tune detection
WOWBOT_AUDIO_DEBUG=1

# Audio detection tuning (lower = more sensitive)
WOWBOT_MIN_AMP=0.005
WOWBOT_SPIKE_MULT=2.0

# Scan region (optional — uncomment and set values to limit scan area)
SCAN_LEFT=1277
SCAN_TOP=228
SCAN_WIDTH=707
SCAN_HEIGHT=302